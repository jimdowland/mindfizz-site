---
layout: layouts/base.njk
bodyClass: insight-page
navKey: insights
ogType: article
---
<article class="article-shell">
  <header class="article-header">
    <a class="eyebrow back-link" href="/insights/">Insights</a>
    <h1>{{ title }}{% if not (title | terminalPunctuation) %}<span class="red-stop">.</span>{% endif %}</h1>
    <p class="article-deck">{{ description }}</p>
    <p class="article-byline">By <a href="/experience/">{{ site.name }}</a></p>
    {% if draft %}<p class="draft-label">Draft · Preview</p>{% else %}<time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>{% endif %}
  </header>
  {% if leadImage %}
  <figure class="article-lead">
    <a href="{{ leadImage }}" target="_blank" rel="noopener" aria-label="Open diagram at full size"><img src="{{ leadImage }}" width="{{ leadImageWidth }}" height="{{ leadImageHeight }}" alt="{{ leadImageAlt }}" fetchpriority="high"></a>
    <figcaption><a href="{{ leadImage }}" target="_blank" rel="noopener">View diagram at full size ↗</a></figcaption>
  </figure>
  {% endif %}
  <div class="article-body prose">
    {{ content | safe }}
  </div>
  <aside class="article-cta">
    <p class="eyebrow">Have something complicated to explain?</p>
    <h2>Bring us the difficult material.</h2>
    <a class="text-link" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a>
  </aside>
</article>
